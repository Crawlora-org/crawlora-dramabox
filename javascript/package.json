{
  "name": "@crawlora-org/dramabox",
  "version": "0.1.0",
  "description": "Crawlora DramaBox API client with 16 endpoints for title discovery, categories, search, rankings, recommendations, and public title details",
  "homepage": "https://crawlora.net/?utm_source=npm&utm_medium=referral&utm_campaign=platform-clients&utm_content=dramabox-javascript-homepage",
  "bugs": { "url": "https://github.com/Crawlora-org/crawlora-dramabox/issues" },
  "keywords": ["crawlora", "api-client", "sdk", "web-scraping", "scraping-api", "dramabox", "dramabox-api", "dramabox-scraper", "dramabox-data", "dramabox-title-discovery", "dramabox-categories", "dramabox-search", "dramabox-rankings", "dramabox-recommendations", "dramabox-public-title-details"],
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "files": ["src", "README.md", "LICENSE"],
  "engines": { "node": ">=18" },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Crawlora-org/crawlora-dramabox",
    "directory": "javascript"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "typecheck": "tsc --noEmit",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "generate": "python3 ../scripts/generate.py"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  }
}
