  },
  "homepage": "https://crawlora.net/?utm_source=packagist&utm_medium=referral&utm_campaign=platform-clients&utm_content=dramabox-php-homepage",
  "support": {
    "source": "https://github.com/Crawlora-org/crawlora-dramabox",
    "docs": "https://crawlora.net/docs?utm_source=packagist&utm_medium=referral&utm_campaign=platform-clients&utm_content=dramabox-php-api-docs"
  }
