{
  "name": "crawlora/dramabox",
  "description": "Crawlora DramaBox API client with 16 endpoints for title discovery, categories, search, rankings, recommendations, and public title details",
  "keywords": [
    "crawlora",
    "api-client",
    "sdk",
    "web-scraping",
    "scraping-api",
    "dramabox",
    "dramabox-api",
    "dramabox-scraper",
    "dramabox-data",
    "dramabox-title-discovery",
    "dramabox-categories",
    "dramabox-search",
    "dramabox-rankings",
    "dramabox-recommendations",
    "dramabox-public-title-details"
  ],
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.1",
    "ext-curl": "*",
    "ext-json": "*"
  },
  "autoload": {
    "psr-4": {
      "Crawlora\\Dramabox\\": "src/Crawlora/Dramabox/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Crawlora\\Dramabox\\Tests\\": "tests/"
    }
  },
  "scripts": {
